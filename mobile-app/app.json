{
  "expo": {
    "name": "Drive Pulse",
    "slug": "safe-driving-mobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "safedrivingmobile",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Drive Pulse to collect trip location while you are driving.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "android": {
      "package": "com.drivepulse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04101B"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.drivepulse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "9234a14f-882a-48c4-ba9d-8f68bec30a00"
      }
    }
  }
}
