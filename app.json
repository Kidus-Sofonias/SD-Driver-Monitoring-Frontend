{
  "expo": {
    "name": "Driver Monitoring System",
    "slug": "safe-driving-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "safedrivingmobile",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Driver Monitoring System to collect trip location while you are driving.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "android": {
      "package": "com.safe.driving.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.safe.driving.mobile"
    },
    "extra": {
      "eas": {
        "projectId": "9234a14f-882a-48c4-ba9d-8f68bec30a00"
      }
    }
  }
}
