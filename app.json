{
  "expo": {
    "name": "Driver Monitoring System",
    "slug": "safe-driving-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Driver Monitoring System to collect trip location while you are driving.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "android": {
      "package": "com.safe.driving.mobile"
    }
  }
}
